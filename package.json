{
  "name": "agent-delivery-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "delivery-gate": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=tap dist/test/*.test.js",
    "test:e2e": "npm run build && node --test --test-reporter=tap dist/e2e/*.test.js",
    "benchmark": "npm run build && node dist/benchmark/run.js",
    "pilot": "npm run build && node dist/pilot/run.js",
    "prepack": "npm run build",
    "verify:self": "npm run build && node dist/src/cli.js verify --config delivery-gate.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
