{
  "schemaVersion": "1",
  "policyId": "incident-desk/browser-v1",
  "command": [
    "node",
    "{policyDir}/../../node_modules/@playwright/test/cli.js",
    "test",
    "--config={policyDir}/../playwright.config.mjs",
    "--reporter=json"
  ],
  "timeoutMs": 90000,
  "maxOutputBytes": 10485760,
  "result": {
    "adapter": "playwright-json",
    "source": "stdout"
  },
  "requireCleanTree": true,
  "requireTests": true,
  "requirePassingTest": true,
  "artifacts": [
    { "path": "{artifactDir}/incident-desk-desktop.png", "required": true },
    { "path": "{artifactDir}/incident-desk-mobile.png", "required": true }
  ]
}
