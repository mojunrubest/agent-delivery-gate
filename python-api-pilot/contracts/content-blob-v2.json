{
  "schemaVersion": "1",
  "policyId": "content-blob/python-http-v2",
  "command": [
    "node",
    "--test",
    "--test-reporter=tap",
    "{policyDir}/../tests/content-blob.contract.test.mjs",
    "{policyDir}/../tests/content-blob.adversarial.contract.test.mjs"
  ],
  "timeoutMs": 90000,
  "maxOutputBytes": 2097152,
  "result": {
    "adapter": "tap",
    "source": "stdout"
  },
  "requireCleanTree": true,
  "requireTests": true,
  "requirePassingTest": true,
  "allowFlaky": false
}
